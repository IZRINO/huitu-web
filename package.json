{
  "name": "huitu-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "bin": { "huitu": "bin/huitu.mjs" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && npm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:skill": "node scripts/build-skill.mjs",
    "test:skill": "node scripts/test-skill.mjs",
    "test:cli": "npm run build:cli && node --test tests/cli.test.mjs",
    "cli": "node bin/huitu.mjs",
    "prepare": "npm run build:cli",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
